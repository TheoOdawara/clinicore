{
  "name": "clinicore-site",
  "version": "0.0.0",
  "private": true,
  "packageManager": "bun@1.4.4",
  "type": "module",
  "imports": {
    "#lib": "./src/lib",
    "#lib/*": "./src/lib/*"
  },
  "scripts": {
    "dev": "vite dev --port 4321",
    "build": "vite build",
    "preview": "vite preview --port 4321 --strictPort",
    "prepare": "svelte-kit sync",
    "check": "svelte-kit sync && svelte-check --fail-on-warnings",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --write .",
    "test": "vitest run",
    "test:boundaries": "node --test eslint-boundaries.test.ts",
    "test:prerender": "node --test prerender.test.ts",
    "e2e": "playwright test",
    "audit": "bun audit"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@eslint/js": "10.0.1",
    "@fontsource-variable/atkinson-hyperlegible-next": "5.3.0",
    "@playwright/test": "1.65.1",
    "@sveltejs/adapter-static": "4.0.1",
    "@sveltejs/kit": "3.3.1",
    "@sveltejs/vite-plugin-svelte": "7.3.1",
    "@testing-library/svelte": "5.4.2",
    "@types/node": "26.6.6",
    "@vitest/coverage-v8": "5.1.1",
    "eslint": "10.15.0",
    "eslint-import-resolver-typescript": "4.4.5",
    "eslint-plugin-boundaries": "7.4.4",
    "eslint-plugin-svelte": "3.24.1",
    "globals": "17.14.0",
    "jiti": "2.7.0",
    "jsdom": "31.0.1",
    "prettier": "3.10.1",
    "prettier-plugin-svelte": "4.2.0",
    "svelte": "5.58.0",
    "svelte-check": "4.7.8",
    "typescript": "6.0.3",
    "typescript-eslint": "8.73.0",
    "vite": "8.3.8",
    "vitest": "5.1.1"
  }
}
