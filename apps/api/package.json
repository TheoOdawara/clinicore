{
  "name": "clinicore-api",
  "private": true,
  "engines": {
    "node": ">=26"
  },
  "scripts": {
    "start": "nest start",
    "dev": "nest start --watch",
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "eslint . --max-warnings 0 --fix",
    "format:check": "prettier --check .",
    "check": "npm run lint && npm run format:check",
    "format:fix": "prettier --write .",
    "fix": "npm run lint:fix && npm run format:fix",
    "typecheck": "tsc --noEmit",
    "build": "nest build",
    "test": "npm run build && node --env-file-if-exists=.env.test ./node_modules/.bin/jest",
    "migration:generate": "node --env-file-if-exists=.env ./node_modules/.bin/typeorm-ts-node-commonjs migration:generate -d src/core/db/data-source.ts",
    "migration:run": "node --env-file-if-exists=.env ./node_modules/.bin/typeorm-ts-node-commonjs migration:run -d src/core/db/data-source.ts",
    "migration:revert": "node --env-file-if-exists=.env ./node_modules/.bin/typeorm-ts-node-commonjs migration:revert -d src/core/db/data-source.ts",
    "test:e2e": "node --env-file-if-exists=.env.test ./node_modules/.bin/jest --config test/jest-e2e.json"
  },
  "dependencies": {
    "@nestjs/common": "11.2.5",
    "@nestjs/config": "4.0.4",
    "@nestjs/core": "11.2.5",
    "@nestjs/jwt": "11.0.2",
    "@nestjs/passport": "11.0.5",
    "@nestjs/platform-express": "11.2.5",
    "@nestjs/swagger": "11.4.7",
    "@nestjs/terminus": "11.1.1",
    "@nestjs/typeorm": "11.0.3",
    "@node-rs/argon2": "2.2.1",
    "class-transformer": "0.5.1",
    "class-validator": "0.15.1",
    "cookie-parser": "1.4.7",
    "ioredis": "5.11.1",
    "passport": "0.7.0",
    "passport-jwt": "4.0.1",
    "pg": "8.23.0",
    "pino": "10.3.1",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "typeorm": "1.1.1",
    "validator": "13.15.35"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@nestjs/cli": "11.0.24",
    "@nestjs/schematics": "11.1.0",
    "@nestjs/testing": "11.2.5",
    "@types/cookie-parser": "1.4.10",
    "@types/express": "5.0.6",
    "@types/jest": "30.0.0",
    "@types/node": "26.6.2",
    "@types/passport-jwt": "4.0.1",
    "@types/supertest": "7.2.1",
    "@types/validator": "13.15.10",
    "eslint": "10.11.0",
    "eslint-config-prettier": "10.1.8",
    "jest": "30.5.2",
    "pino-pretty": "13.1.3",
    "prettier": "3.9.8",
    "supertest": "7.2.2",
    "ts-jest": "29.4.12",
    "ts-node": "10.9.2",
    "typescript": "6.0.3",
    "typescript-eslint": "8.70.0"
  },
  "jest": {
    "preset": "ts-jest",
    "testEnvironment": "node",
    "rootDir": "src",
    "testRegex": "__tests__/.*\\.test\\.ts$"
  }
}
