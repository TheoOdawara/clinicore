APP_ENV=development | production | test
LOG_LEVEL=error | warn | info | debug | trace | off
PORT=integer between 1 and 65535
DATABASE_URL=postgresql://<user>:<password>@localhost:<POSTGRES_PORT>/<database>
REDIS_URL=redis://localhost:<REDIS_PORT>
ALLOWED_ORIGINS=comma-separated origins, e.g. http://localhost:3000
APP_ORIGIN=one of ALLOWED_ORIGINS, the web origin used in email links
CLIENT_IP_SOURCE=peer | cf-connecting-ip | x-forwarded-for:<1-5>
JWT_SECRET=string with at least 32 characters
MAIL_FROM=Name <address@domain>
MAIL_REDIRECT_TO=off | an address that receives every email (development and test only)
SMTP_HOST=hostname (localhost for Mailpit)
SMTP_PORT=integer between 1 and 65535 (MAILPIT_SMTP_PORT in development)
SMTP_TLS=starttls | tls | none (none only outside production)
SMTP_USER=non-empty string
SMTP_PASSWORD=non-empty string
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=
POSTGRES_PORT=
REDIS_PORT=
MAILPIT_SMTP_PORT=
MAILPIT_UI_PORT=
