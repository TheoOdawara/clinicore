  "query": "\n        SELECT\n            count(*) AS \"in_window!\",\n            count(*) FILTER (WHERE created_at > now() - $3::interval) AS \"in_spacing!\"\n        FROM email_dispatches\n        WHERE email = $1 AND kind = $2 AND created_at > now() - $4::interval\n        ",
