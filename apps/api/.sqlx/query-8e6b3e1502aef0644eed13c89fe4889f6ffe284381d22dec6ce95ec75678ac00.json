  "query": "\n        SELECT users.id AS user_id, users.name, users.email_verified, accounts.password_hash\n        FROM users\n        JOIN accounts ON accounts.user_id = users.id AND accounts.provider = 'credential'\n        WHERE users.email = $1\n        ",
