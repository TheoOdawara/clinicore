{
	"testEnvironment": "jsdom",
	"roots": ["<rootDir>/src"],
	"testMatch": ["<rootDir>/src/**/__tests__/**/*.test.ts?(x)"],
	"transform": {
		"^.+\\.tsx?$": [
			"@swc/jest",
			{
				"jsc": {
					"parser": {
						"syntax": "typescript",
						"tsx": true
					},
					"transform": {
						"react": {
							"runtime": "automatic"
						}
					}
				}
			}
		]
	}
}
